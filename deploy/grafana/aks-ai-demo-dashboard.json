{
  "title": "AKS AI Demo",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat", "title": "Devices reporting",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "count(count by (device_id)(aidemo_device_indoor_temp_c))" }]
    },
    {
      "type": "timeseries", "title": "Indoor temperature by device",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "targets": [{ "expr": "aidemo_device_indoor_temp_c", "legendFormat": "{{device_id}}" }]
    },
    {
      "type": "timeseries", "title": "Job duration (seconds)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(aidemo_job_duration_seconds_bucket[5m])) by (le, job_type))", "legendFormat": "p95 {{job_type}}" }]
    },
    {
      "type": "timeseries", "title": "Forecast MAPE (%)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "aidemo_forecast_mape", "legendFormat": "{{dataset}}" }]
    },
    {
      "type": "timeseries", "title": "RL mean reward",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "aidemo_rl_mean_reward", "legendFormat": "{{algo}}" }]
    },
    {
      "type": "timeseries", "title": "GPU utilization",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "{{Hostname}} gpu{{gpu}}" }]
    }
  ]
}
